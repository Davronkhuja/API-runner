name: CI
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - uses: actions/setup-node@v4
        with: { node-version: "20" }
      - run: pip install -r requirements-dev.txt && playwright install --with-deps chromium
      - run: cd web && npm ci && npm run build && npx vitest run
      - run: python3 tools/check_fixed_heights.py
      # Vizual regressiya baseline'i macOS'da olingan: Linux shrift renderi farq qilsa UPDATE_BASELINE=1 bilan CI'da qayta yarating
      - run: python3 -m pytest -n 4
